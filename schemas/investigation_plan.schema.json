{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cehpoint.example/soc/investigation_plan.schema.json",
  "title": "Investigation plan (content produced by the agent)",
  "description": "What Hermes must submit via the submit_investigation_plan tool. The application adds plan_id, alert_id, created_at and generated_by around it.",
  "type": "object",
  "required": [
    "summary",
    "hypotheses",
    "key_questions",
    "steps",
    "safety_notes",
    "data_gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200,
      "description": "What the alert claims and why it needs investigating. No conclusions yet."
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "description": "Competing explanations; at least one must be benign (benign: true).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "benign",
          "would_be_supported_by",
          "would_be_refuted_by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^H[0-9]{1,2}$",
            "description": "H1, H2, ..."
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "benign": {
            "type": "boolean",
            "description": "true if this explanation is not malicious (e.g. the real user mistyping a password)."
          },
          "would_be_supported_by": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "would_be_refuted_by": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "benign"
        ],
        "properties": {
          "benign": {
            "const": true
          }
        }
      }
    },
    "key_questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "step",
          "objective",
          "tool",
          "parameters",
          "rationale",
          "expected_evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "description": "1, 2, 3, ... in order."
          },
          "objective": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "tool": {
            "type": "string",
            "enum": [
              "search_logs",
              "lookup_ip",
              "search_cve",
              "get_asset_context",
              "analyst_review"
            ],
            "description": "Approved investigation tool to use in this step (implemented on Day 2), or analyst_review for a human-only step."
          },
          "parameters": {
            "type": "object",
            "description": "Planned arguments for the tool. Use keys such as account, host, src_ip, ip, service, start, end. Accounts, hosts and IP addresses must appear in the alert."
          },
          "rationale": {
            "type": "string",
            "minLength": 5,
            "maxLength": 400
          },
          "expected_evidence": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          }
        }
      }
    },
    "safety_notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      },
      "description": "Constraints, e.g. containment actions require analyst approval."
    },
    "data_gaps": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      },
      "description": "What the alert alone does not tell us."
    }
  }
}
