{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cehpoint.example/soc/tools/submit_findings.output.json",
  "title": "submit_findings result",
  "type": "object",
  "required": [
    "accepted",
    "message",
    "severity_check"
  ],
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "const": true
    },
    "message": {
      "type": "string"
    },
    "severity_check": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
