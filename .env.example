# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored - never commit a real key. Secrets are read from the environment only.

# LLM provider: "nvidia" (NVIDIA NIM, OpenAI-compatible) or "mock" (offline deterministic script, NOT an AI model)
SOC_LLM_PROVIDER=nvidia

# NVIDIA API key from https://build.nvidia.com (starts with nvapi-). Leave empty in this example file.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Must be a model with tool calling enabled on NVIDIA NIM
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Agent limits
SOC_MAX_ITERATIONS=9
SOC_INVESTIGATION_MAX_ITERATIONS=20
SOC_ASSESSMENT_MAX_ITERATIONS=28
SOC_REPORT_MAX_ITERATIONS=16
SOC_MAX_TOKENS=4096
SOC_ASSESSMENT_MAX_TOKENS=8192
# Hermes retries per LLM call on HTTP 429 / 5xx (exponential backoff up to 60 s); Hermes's own default is 3
SOC_API_MAX_RETRIES=6
# Per tool call; a slower call returns status "timeout" and no data
SOC_TOOL_TIMEOUT_S=5

# Fault injection for tests / demos ONLY (leave empty): e.g. lookup_ip:timeout,search_cve:error
SOC_FAULTS=

# Local state (git-ignored). Relative paths are resolved from the project root.
SOC_RUNS_DIR=runs
SOC_HERMES_HOME=.hermes
SOC_DATA_DIR=data
# Day 4: investigation history + append-only, hash-chained audit trail (SQLite), and rendered reports
SOC_DB_PATH=state/soc.db
SOC_REPORTS_DIR=reports
# SIMULATED executions of analyst-approved actions are logged here (nothing real is ever changed)
SOC_SIMULATED_ACTIONS_LOG=data/simulated_actions.log

# Analyst token for the API's approve / reject / execute / close endpoints (header X-Analyst-Token).
# Leave empty to disable those endpoints (they answer 503). Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYST_API_TOKEN=

# Data minimization: only synthetic / Cehpoint-approved lab data may be sent to the LLM.
